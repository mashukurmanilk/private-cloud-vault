# Database Configuration (SQLite)
DATABASE_URL="file:./prisma/vault.db"

# JWT Secret for Session Authentication (Use a strong random 32+ character string in production)
JWT_SECRET="replace-with-a-very-long-secure-random-secret-key"

# Storage Directory for Uploads
STORAGE_DIR="./uploads"

# Server Port
PORT=3000

# Set to "true" if deploying with HTTPS domain to enforce secure cookies
COOKIE_SECURE="false"

# Node Environment
NODE_ENV="production"
